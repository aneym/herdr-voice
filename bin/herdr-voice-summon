#!/bin/zsh
# Runs ON THE HERDR SERVER (studio), bound to prefix+m. TOGGLE:
#   engine off -> start it on the hands machine (LaunchAgent, GUI session so
#                 mic TCC works), wait for its reverse-tunneled control socket,
#                 open the native HUD pane inside herdr.
#   engine on  -> stop it (HUD pane notices and reports engine gone).
# The HUD is a normal herdr pane (plugin pane, placement=split) — non-modal,
# lives inside herdr, no OS floating windows.
set -uo pipefail

HANDS_HOST="${HERDR_VOICE_HANDS_HOST:-macbook-ts}"
AGENT_LABEL="${HERDR_VOICE_AGENT_LABEL:-com.aneyman.herdr-voice-engine}"
CTL="$HOME/.cache/herdr-voice/ctl.sock"

hnote() {
  [[ -n "${HERDR_SOCKET_PATH:-}" ]] || return 0
  printf '{"id":"hv","method":"notification.show","params":{"title":"%s","body":"%s"}}\n' "$1" "${2:-}" \
    | nc -U "$HERDR_SOCKET_PATH" -w 2 >/dev/null 2>&1
}

ctl_alive() {
  [[ -S "$CTL" ]] && printf '\n' | nc -U "$CTL" -w 1 >/dev/null 2>&1
}

# --stop = fully stop the engine (the popup HUD itself is dismissed with Esc;
# the engine idles muted in the background for instant reopen otherwise)
if [[ "${1:-}" == "--stop" ]]; then
  ctl_alive && printf '{"cmd":"stop"}\n' | nc -U "$CTL" -w 2 >/dev/null 2>&1
  hnote "voice: engine stopped"
  exit 0
fi

if ! ctl_alive; then
  # start the engine in the hands machine's GUI session
  if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$HANDS_HOST" \
    "launchctl kickstart -k gui/\$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; then
    hnote "voice: cannot start engine" "$HANDS_HOST unreachable or LaunchAgent missing"
    exit 1
  fi
  for _ in {1..20}; do
    ctl_alive && break
    sleep 0.5
  done
  if ! ctl_alive; then
    hnote "voice: engine did not come up" "check ~/.cache/herdr-voice/engine.log on $HANDS_HOST"
    exit 1
  fi
fi

# open the HUD (plugin must be installed: aneym/herdr-voice).
# Prefer the non-modal floating placement (fork feature 7, open-time override);
# servers without it reject the unknown field -> fall back to the plain popup.
if [[ -n "${HERDR_SOCKET_PATH:-}" ]]; then
  resp=$(printf '{"id":"hv2","method":"plugin.pane.open","params":{"plugin_id":"herdr-voice","entrypoint":"hud","placement":"floating","anchor":"top_right","width":"42%%","height":14}}\n' \
    | nc -U "$HERDR_SOCKET_PATH" -w 3 2>/dev/null)
  if ! print -r -- "$resp" | grep -q '"result"'; then
    printf '{"id":"hv3","method":"plugin.pane.open","params":{"plugin_id":"herdr-voice","entrypoint":"hud"}}\n' \
      | nc -U "$HERDR_SOCKET_PATH" -w 3 >/dev/null 2>&1 || hnote "voice: engine up" "open the HUD pane manually"
  fi
fi
exit 0
