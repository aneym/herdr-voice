#!/bin/zsh
# Engine wrapper — runs on the hands machine (MacBook), usually via the
# com.aneyman.herdr-voice-engine LaunchAgent so mic TCC lives in the GUI session.
#
# Establishes both tunnels, then execs the headless engine:
#   forward:  local herdr socket  <- studio's ~/.config/herdr/herdr.sock
#   reverse:  studio ctl.sock     <- local engine control socket
# The reverse tunnel is what lets a herdr pane on the studio render the HUD.
set -euo pipefail

HOST="${HERDR_VOICE_HOST:-studio-ts}"
APP_DIR="${0:A:h:h}"
RUN_DIR="$HOME/.cache/herdr-voice"
SOCK="$RUN_DIR/$HOST.sock"
CTL="$RUN_DIR/ctl.sock"
mkdir -p "$RUN_DIR"

PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$PATH"

# singleton engine
pkill -f "herdr-voice.*src/engine.js" 2>/dev/null && sleep 0.3 || true

sock_alive() {
  [[ -S "$SOCK" ]] && printf '{"id":"1","method":"ping","params":{}}\n' | nc -U "$SOCK" -w 2 | grep -q pong
}

REMOTE_HOME=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" 'printf %s "$HOME"')

if ! sock_alive; then
  rm -f "$SOCK"
  ssh -f -N -o ExitOnForwardFailure=yes -o ConnectTimeout=10 \
    -L "$SOCK:$REMOTE_HOME/.config/herdr/herdr.sock" "$HOST"
  for _ in {1..10}; do sock_alive && break; sleep 0.3; done
fi
sock_alive || { echo "herdr on $HOST unreachable" >&2; exit 1 }

# reverse tunnel for the HUD pane on the studio. sshd won't unlink a stale
# remote socket (StreamLocalBindUnlink defaults to no) — remove it first, and
# kill any previous reverse-tunnel ssh.
pkill -f "ssh.*-R.*herdr-voice/ctl.sock" 2>/dev/null || true
ssh -o BatchMode=yes "$HOST" "mkdir -p ~/.cache/herdr-voice && rm -f ~/.cache/herdr-voice/ctl.sock"
ssh -f -N -o ExitOnForwardFailure=yes -o ConnectTimeout=10 \
  -R "$REMOTE_HOME/.cache/herdr-voice/ctl.sock:$CTL" "$HOST"

exec node "$APP_DIR/src/engine.js" --socket "$SOCK" "$@"
