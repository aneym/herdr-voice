#!/bin/zsh
# Engine wrapper — runs on the hands machine (MacBook) via the
# com.aneyman.herdr-voice-engine LaunchAgent (GUI session → mic TCC works).
# All tunnel management lives in the engine itself (src/tunnels.js): tunnels
# are engine children, so restarts stay coherent and drops self-heal.
set -euo pipefail

HOST="${HERDR_VOICE_HOST:-studio-ts}"
APP_DIR="${0:A:h:h}"

PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$PATH"

# singleton engine (its child tunnels die with it)
pkill -f "herdr-voice.*src/engine.js" 2>/dev/null && sleep 0.3 || true

exec node "$APP_DIR/src/engine.js" --tunnel-host "$HOST" "$@"
